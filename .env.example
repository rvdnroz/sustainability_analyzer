# Copy to .env and fill in only the providers you use. Never commit .env.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

LLM_PROVIDER=groq
# Leave blank to use the provider default; select a model available to your account.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Required only for automatic report discovery (not for --pdf-path or --url).
EXA_API_KEY=

# Optional vision features; disabled by default.
VLM_FALLBACK_ENABLED=false
VISION_FALLBACK_ENABLED=false
VISION_PROVIDER=openrouter
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# Local files are the default. Enable Azure explicitly when needed.
STORAGE_BACKEND=local
SYNC_TO_BLOB=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
