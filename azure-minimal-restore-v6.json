{
    "containers":  [
                       {
                           "name":  "sustainability-analyzer",
                           "args":  [
                                        "main.py",
                                        "--data-directory",
                                        "/app/data",
                                        "batch",
                                        "--company",
                                        "Example Company",
                                        "--year",
                                        "2023",
                                        "--report-id",
                                        "example_2023",
                                        "--skip-ingestion",
                                        "--restore-from-blob",
                                        "--restore-prefix",
                                        "reports/example_2023",
                                        "--questions-file",
                                        "/app/config_data/questions.json",
                                        "--groups",
                                        "water",
                                        "--output-directory",
                                        "/app/outputs",
                                        "--llm-provider",
                                        "groq",
                                        "--llm-model",
                                        "qwen/qwen3.6-27b",
                                        "--disable-vlm-fallback",
                                        "--disable-vision-fallback",
                                        "--sync-to-blob",
                                        "--sync-required",
                                        "--blob-prefix",
                                        "reports/example_2023/results"
                                    ],
                           "resources":  {
                                             "cpu":  2,
                                             "memory":  "4Gi"
                                         },
                           "command":  [
                                           "python"
                                       ],
                           "image":  "exampleacr.azurecr.io/sustainability-analyzer:v6",
                           "env":  [
                                       {
                                           "value":  "azure_blob",
                                           "name":  "STORAGE_BACKEND"
                                       },
                                       {
                                           "secretRef":  "storage-connection",
                                           "name":  "AZURE_STORAGE_CONNECTION_STRING"
                                       },
                                       {
                                           "value":  "example-data",
                                           "name":  "AZURE_STORAGE_CONTAINER"
                                       },
                                       {
                                           "secretRef":  "groq-api-key",
                                           "name":  "GROQ_API_KEY"
                                       },
                                       {
                                           "secretRef":  "exa-api-key",
                                           "name":  "EXA_API_KEY"
                                       },
                                       {
                                           "value":  "groq",
                                           "name":  "LLM_PROVIDER"
                                       },
                                       {
                                           "value":  "qwen/qwen3.6-27b",
                                           "name":  "LLM_MODEL"
                                       },
                                       {
                                           "value":  "true",
                                           "name":  "SYNC_TO_BLOB"
                                       }
                                   ]
                       }
                   ]
}
